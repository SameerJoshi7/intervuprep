# Copy to .env and fill in your values.
# Local PostgreSQL (the running postgresql-x64-16 service uses port 5432).
DATABASE_URL="postgresql://intervu:intervu@localhost:5432/intervu_prep?schema=public"

# Secret for signing JWTs — use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Where the frontend runs (for CORS).
CLIENT_ORIGIN="http://localhost:5173"

PORT=4000
